{
  "name": "meshkeep",
  "version": "0.1.0",
  "description": "A private, self-hostable AI workspace for small teams.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database for accounts, projects, conversations and the search index."
      },
      "FILES": {
        "description": "R2 bucket for uploaded project files."
      },
      "OWNER_SETUP_TOKEN": {
        "description": "**At least 32 random characters**, for example from `openssl rand -hex 32`. After deploying, open `/setup` and enter it to create the owner account. Keep it: it also restores owner access later."
      },
      "PROVIDER_KEY_ENCRYPTION_KEY": {
        "description": "Encrypts the model-provider API keys that members save. **At least 32 random characters**, for example from `openssl rand -hex 32`. Changing it later makes saved keys unreadable."
      }
    }
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate && wrangler deploy",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib db proxy.ts",
    "test": "vitest run",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test:api": "vitest run --config vitest.api.config.ts",
    "check:public": "node scripts/check-public-repo.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "^1.8.1",
    "vinext": "1.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0"
  },
  "type": "module"
}
