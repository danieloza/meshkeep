# Copy this file to .dev.vars. Never share or commit .dev.vars.
APP_ORIGIN=http://127.0.0.1:3080

# `standalone` (default) for any host other than OpenAI Sites; `sites` only
# when Sites sets the identity headers. See "Authentication modes" in README.
AUTH_MODE=standalone
# Standalone mode: at least 32 random characters. Opens /setup for the owner.
OWNER_SETUP_TOKEN=replace-me-with-random-secret-of-32-plus-chars

# Sites mode only: first-owner bootstrap through the hosting identity.
OWNER_ACCOUNT_USER_ID=your_chatgpt_account_user_id
OWNER_EMAIL=owner@example.com
ALLOW_FIRST_USER_BOOTSTRAP=false

# Required only when users save their own provider credentials. Use a unique,
# randomly generated value with at least 32 characters.
PROVIDER_KEY_ENCRYPTION_KEY=replace-me-with-random-secret

# Optional legacy team provider. Leave blank for bring-your-own-provider mode.
TOKENROUTER_API_KEY=

# Optional shared Google Drive storage (OAuth with the drive.file scope).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
